<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_reverse" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.reverse</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Реверс - Локации" name="reverse_locations_settings">
                    <setting id="reverse_auto_locations" string="Автоматски локации" help="Контролирај кога автоматски се креираат stock локации">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="reverse_auto_create_employee_location" class="col-lg-4 o_light_label"/>
                                <field name="reverse_auto_create_employee_location"/>
                            </div>
                            <div class="row">
                                <label for="reverse_auto_create_vehicle_location" class="col-lg-4 o_light_label"/>
                                <field name="reverse_auto_create_vehicle_location"/>
                            </div>
                            <div class="row">
                                <label for="reverse_auto_create_team_location" class="col-lg-4 o_light_label"/>
                                <field name="reverse_auto_create_team_location"/>
                            </div>
                            <div class="row">
                                <label for="reverse_auto_create_partner_location" class="col-lg-4 o_light_label"/>
                                <field name="reverse_auto_create_partner_location"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="reverse_wizard_defaults" string="Wizard - Стандардни вредности" help="Стандардни вредности при креирање реверс преку wizard">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="reverse_default_return_days" class="col-lg-4 o_light_label"/>
                                <field name="reverse_default_return_days"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="reverse_fsm_priority" string="FSM приоритет" help="Приоритет при избор на локација за теренски работи">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="reverse_fsm_location_priority" class="col-lg-4 o_light_label"/>
                                <field name="reverse_fsm_location_priority"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
