<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_eskon_reverse" model="ir.ui.view">
        <field name="name">hr.employee.form.eskon_reverse</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_equipment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="not stock_location_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="stock_equipment_count"/>
                        </span>
                        <span class="o_stat_text">Опрема</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
